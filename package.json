{
  "name": "phomu",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "validate-songs": "npx tsx src/utils/validate-song-data.ts",
    "validate-catalog": "npx tsx src/utils/validate-song-catalog.ts",
    "audit-youtube-official": "node scripts/audit-official-youtube-links.js",
    "validate-catalog-strict": "npx tsx src/utils/validate-song-catalog.ts --strict",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e:install": "npx playwright install chromium",
    "test:e2e:install:linux": "npx playwright install-deps chromium",
    "screenshot:settings": "node scripts/capture-settings-screenshots.mjs",
    "test:e2e:smoke": "npx @playwright/test test e2e/smoke.spec.ts",
    "format:check": "prettier --check .",
    "validate-catalog:report": "npx tsx src/utils/validate-song-catalog.ts --write-report",
    "security:rotate-admin-token": "node scripts/generate-admin-token.js",
    "phase1:acceptance": "npm run typecheck && npm run validate-catalog:report && npm run test:e2e:smoke && node scripts/check-phase1-acceptance.js",
    "local-ci": "bash scripts/local-ci.sh",
    "check:i18n": "node scripts/check-i18n-completeness.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:file-size:test": "node scripts/check-file-size.test.mjs",
    "check:doc-language": "node scripts/check-doc-language.mjs",
    "check:license": "node scripts/check-license.mjs",
    "check:crate-boundaries": "node scripts/check-crate-boundaries.mjs",
    "check:crate-boundaries:test": "node scripts/check-crate-boundaries.test.mjs",
    "check:module-boundaries": "node scripts/check-module-boundaries.mjs",
    "check:module-boundaries:test": "node scripts/check-module-boundaries.test.mjs",
    "check:conformance": "node scripts/verify-conformance.mjs",
    "check:all": "node scripts/check-all.mjs",
    "postinstall": "node scripts/setup-git-hooks.js",
    "generate:variant-keys": "node scripts/generate-variant-keys.mjs",
    "seed:shared-keys": "node scripts/seed-shared-keys.mjs",
    "verify:i18n-keys": "node scripts/verify-used-i18n-keys.mjs",
    "merge:i18n-parts": "node scripts/merge-i18n-parts.mjs"
  },
  "dependencies": {
    "@emnapi/core": "^1.9.1",
    "@emnapi/runtime": "^1.9.1",
    "framer-motion": "^12.38.0",
    "html5-qrcode": "^2.3.8",
    "i18next": "^26.0.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "ytsr": "^3.8.4"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
