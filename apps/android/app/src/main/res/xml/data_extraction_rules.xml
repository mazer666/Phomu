<?xml version="1.0" encoding="utf-8"?>
<!--
  The rules of the extraction of the data of the application.

  WHY the data of the application is not extracted: the session and the
  settings belong to the device the game is played on, and the catalogue is
  an asset of the application (docs/spec/REQUIREMENTS-PLATFORM.md, PLAT-110).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
