<?xml version="1.0" encoding="utf-8"?>
<!--
  The theme of the application.

  WHY the shell has its own theme and does not use a Material one: the theme
  of the product is one of the four themes of the shell, and the colours of
  the application come from the theme the player has chosen. The theme of
  the manifest is only the frame before the first composition.
-->
<resources>
    <style name="Theme.Phomu" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
